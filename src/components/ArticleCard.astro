---
const { post } = Astro.props;
const { title, description, category, pubDate, tags, image, imageAlt } = post.data;
const date = new Intl.DateTimeFormat('ko-KR',{year:'numeric',month:'long',day:'numeric'}).format(pubDate);
const base = import.meta.env.BASE_URL;
---
<article class="card">
  <a href={`${base}blog/${post.slug}/`} aria-label={title}>
    {image ? (
      <div class="card-media has-image">
        <img src={image} alt={imageAlt || title} loading="lazy" width="1200" height="675" />
      </div>
    ) : (
      <div class="card-media">
        <div>
          <small>{category}</small>
          <div style="font-family:Georgia,serif;font-size:1.35rem;margin-top:4px">Insight · Guide · Review</div>
        </div>
      </div>
    )}
    <div class="card-body">
      <div class="card-kicker">{category}</div>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="card-meta"><span>{date}</span><span>{tags?.[0] || 'Insight'}</span></div>
    </div>
  </a>
</article>
