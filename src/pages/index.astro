---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const now = new Date();
const posts = (await getCollection('blog', ({data}) => !data.draft && data.pubDate <= now)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest = posts.slice(0,6);
---
<BaseLayout title="스마트폰·AI·디지털 생활 실용 가이드" description="스마트폰, 앱, AI 활용, 인터넷 서비스, 디지털 보안과 기기 문제 해결을 실제로 따라 할 수 있게 정리하는 생활기술 실용 정보 블로그입니다.">
  <section class="hero hero-compact">
    <div class="container">
      <h1>생활과 기술을 더 쉽게, 더 정확하게.</h1>
      <p>스마트폰, 앱, AI 활용과 디지털 생활 문제를 실제로 해결할 수 있는 방법 중심으로 정리합니다.</p>
    </div>
  </section>

  <section class="section section-latest">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Latest</div><h2>최근 글</h2></div>
      </div>
      <div class="grid">{latest.map(post => <ArticleCard post={post} />)}</div>
    </div>
  </section>
</BaseLayout>
