---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featured = posts.find(p=>p.data.featured) || posts[0];
const latest = posts.slice(0,6);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="생활기술노트" description="생활, 기술, 스마트폰, 디지털 도구를 더 쉽게 이해하고 활용하도록 돕는 실용 정보 블로그입니다.">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Practical Digital & Life Guide</div>
      <h1>생활과 기술을<br/>더 쉽게, 더 정확하게.</h1>
      <p>스마트폰, 디지털 도구, 생활 속 기술을 실제로 활용할 수 있도록 핵심만 정확하고 이해하기 쉽게 정리합니다.</p>
      <div class="hero-meta">
        <span class="pill">스마트폰 활용</span><span class="pill">디지털 생활</span><span class="pill">실용 가이드</span><span class="pill">비교·해설</span>
      </div>
    </div>
  </section>

  {featured && <section class="section">
    <div class="container">
      <div class="feature">
        <div class="feature-copy">
          <div class="eyebrow" style="color:#83d3cb">Featured Article</div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <p style="margin-top:24px"><a href={`${base}blog/${featured.slug}/`} style="font-weight:800">글 읽기 →</a></p>
        </div>
        <div class="feature-side">
          <div><div style="font-size:.8rem;opacity:.75">PRACTICAL NOTE</div><div style="font-size:1.25rem;font-weight:700;margin-top:8px">핵심부터 빠르게, 필요한 내용은 깊게.</div></div>
        </div>
      </div>
    </div>
  </section>}

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Latest</div><h2>최근 글</h2></div><p>검증 기준을 통과한 실용 정보만 발행합니다.</p></div>
      <div class="grid">{latest.map(post => <ArticleCard post={post} />)}</div>
    </div>
  </section>
</BaseLayout>
