---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="SEO 관리자" description="생활기술노트 Search Console 비공개 관리자 화면" indexable={false}>
  <section class="container admin-wrap">
    <div class="admin-card">
      <div class="eyebrow">Private Search Console Dashboard</div>
      <h1>검색 성과 관리자</h1>
      <p class="admin-help">이 페이지 주소는 공개될 수 있지만, Search Console 데이터는 Google 로그인과 해당 속성 권한이 있어야만 불러올 수 있습니다. 통계 데이터는 사이트 HTML에 저장하지 않습니다.</p>

      <div class="setup-box">
        <label for="clientId">Google OAuth 웹 클라이언트 ID</label>
        <input id="clientId" type="text" inputmode="text" autocomplete="off" placeholder="xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com" />
        <div class="button-row">
          <button id="saveClientId" type="button">이 기기에 저장</button>
          <button id="clearClientId" class="ghost" type="button">저장값 지우기</button>
        </div>
        <p class="tiny">클라이언트 ID는 비밀번호가 아니며 이 브라우저의 localStorage에만 저장됩니다.</p>
      </div>

      <div class="button-row">
        <button id="loginBtn" type="button">Google로 로그인해 통계 보기</button>
        <button id="logoutBtn" class="ghost" type="button" hidden>로그아웃</button>
      </div>
      <p id="status" class="status" aria-live="polite">로그인 전입니다.</p>
    </div>

    <div id="dashboard" hidden>
      <div class="stats-grid">
        <article class="stat"><span>클릭</span><strong id="clicks">-</strong></article>
        <article class="stat"><span>노출</span><strong id="impressions">-</strong></article>
        <article class="stat"><span>CTR</span><strong id="ctr">-</strong></article>
        <article class="stat"><span>평균 순위</span><strong id="position">-</strong></article>
      </div>

      <div class="admin-grid">
        <section class="admin-card">
          <h2>상위 검색어</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>검색어</th><th>클릭</th><th>노출</th><th>CTR</th><th>순위</th></tr></thead>
              <tbody id="queryRows"></tbody>
            </table>
          </div>
        </section>

        <section class="admin-card">
          <h2>상위 페이지</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>페이지</th><th>클릭</th><th>노출</th><th>CTR</th><th>순위</th></tr></thead>
              <tbody id="pageRows"></tbody>
            </table>
          </div>
        </section>
      </div>
      <p class="tiny">기준: 최근 28일(데이터 지연을 고려해 3일 전까지). Search Console 원본 데이터를 브라우저에서 직접 조회합니다.</p>
    </div>
  </section>

  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script is:inline>
    const SITE_URL = 'https://lovingublog-lab.github.io/auto-seo-blog/';
    const SCOPE = 'https://www.googleapis.com/auth/webmasters.readonly';
    let tokenClient;
    let accessToken = '';

    const $ = (id) => document.getElementById(id);
    const status = $('status');
    const clientInput = $('clientId');

    clientInput.value = localStorage.getItem('gsc_oauth_client_id') || '';

    $('saveClientId').addEventListener('click', () => {
      const value = clientInput.value.trim();
      if (!value) {
        status.textContent = '클라이언트 ID를 입력하세요.';
        return;
      }
      localStorage.setItem('gsc_oauth_client_id', value);
      status.textContent = '이 기기에 클라이언트 ID를 저장했습니다.';
    });

    $('clearClientId').addEventListener('click', () => {
      localStorage.removeItem('gsc_oauth_client_id');
      clientInput.value = '';
      status.textContent = '저장된 클라이언트 ID를 지웠습니다.';
    });

    function isoDate(d) {
      return d.toISOString().slice(0, 10);
    }

    function range28() {
      const end = new Date();
      end.setDate(end.getDate() - 3);
      const start = new Date(end);
      start.setDate(start.getDate() - 27);
      return { startDate: isoDate(start), endDate: isoDate(end) };
    }

    async function gscQuery(dimensions = []) {
      const body = { ...range28(), rowLimit: dimensions.length ? 10 : 1 };
      if (dimensions.length) body.dimensions = dimensions;

      const url = 'https://searchconsole.googleapis.com/webmasters/v3/sites/' +
        encodeURIComponent(SITE_URL) + '/searchAnalytics/query';

      const res = await fetch(url, {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + accessToken,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(body)
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err?.error?.message || 'Search Console 데이터를 불러오지 못했습니다.');
      }
      return res.json();
    }

    function pct(v) { return ((Number(v) || 0) * 100).toFixed(1) + '%'; }
    function pos(v) { const n = Number(v) || 0; return n ? n.toFixed(1) : '-'; }
    function num(v) { return Math.round(Number(v) || 0).toLocaleString('ko-KR'); }

    function fillRows(target, rows, isPage = false) {
      target.innerHTML = '';
      if (!rows?.length) {
        target.innerHTML = '<tr><td colspan="5" class="empty">아직 데이터가 없습니다.</td></tr>';
        return;
      }
      rows.forEach(r => {
        const tr = document.createElement('tr');
        const label = r.keys?.[0] || '';
        tr.innerHTML = `<td class="label-cell"></td><td>${num(r.clicks)}</td><td>${num(r.impressions)}</td><td>${pct(r.ctr)}</td><td>${pos(r.position)}</td>`;
        const first = tr.querySelector('.label-cell');
        first.textContent = isPage ? label.replace(SITE_URL, '/') : label;
        target.appendChild(tr);
      });
    }

    async function loadDashboard() {
      status.textContent = 'Search Console 데이터를 불러오는 중입니다…';
      const [summary, queries, pages] = await Promise.all([
        gscQuery(),
        gscQuery(['query']),
        gscQuery(['page'])
      ]);

      const s = summary.rows?.[0] || {};
      $('clicks').textContent = num(s.clicks);
      $('impressions').textContent = num(s.impressions);
      $('ctr').textContent = pct(s.ctr);
      $('position').textContent = pos(s.position);
      fillRows($('queryRows'), queries.rows, false);
      fillRows($('pageRows'), pages.rows, true);

      $('dashboard').hidden = false;
      $('logoutBtn').hidden = false;
      status.textContent = '최근 28일 Search Console 데이터를 표시했습니다.';
    }

    $('loginBtn').addEventListener('click', () => {
      const clientId = clientInput.value.trim() || localStorage.getItem('gsc_oauth_client_id') || '';
      if (!clientId) {
        status.textContent = '먼저 Google OAuth 웹 클라이언트 ID를 입력하세요.';
        return;
      }

      if (!window.google?.accounts?.oauth2) {
        status.textContent = 'Google 로그인 모듈을 아직 불러오는 중입니다. 잠시 후 다시 눌러주세요.';
        return;
      }

      tokenClient = google.accounts.oauth2.initTokenClient({
        client_id: clientId,
        scope: SCOPE,
        callback: async (resp) => {
          if (resp.error) {
            status.textContent = 'Google 로그인에 실패했습니다: ' + resp.error;
            return;
          }
          accessToken = resp.access_token;
          try {
            await loadDashboard();
          } catch (e) {
            status.textContent = e.message;
          }
        }
      });
      tokenClient.requestAccessToken({ prompt: 'consent' });
    });

    $('logoutBtn').addEventListener('click', () => {
      if (accessToken && window.google?.accounts?.oauth2) {
        google.accounts.oauth2.revoke(accessToken, () => {});
      }
      accessToken = '';
      $('dashboard').hidden = true;
      $('logoutBtn').hidden = true;
      status.textContent = '로그아웃했습니다.';
    });
  </script>

  <style>
    .admin-wrap{padding:48px 0 72px}
    .admin-card{background:#fff;border:1px solid #dfe7ef;border-radius:20px;padding:24px;box-shadow:0 10px 30px rgba(15,35,60,.06);margin-bottom:22px}
    .admin-card h1{margin:.25rem 0 1rem}
    .admin-card h2{margin-top:0}
    .admin-help,.status,.tiny{color:var(--muted)}
    .setup-box{padding:18px;background:#f5f8fb;border-radius:14px;margin:18px 0}
    .setup-box label{display:block;font-weight:800;margin-bottom:8px}
    .setup-box input{width:100%;padding:13px 14px;border:1px solid #cbd7e4;border-radius:10px;font:inherit;background:#fff}
    .button-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    button{border:0;border-radius:10px;padding:12px 16px;font:inherit;font-weight:800;cursor:pointer;background:#153a65;color:#fff}
    button.ghost{background:#eef3f7;color:#153a65}
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:22px 0}
    .stat{background:#153a65;color:#fff;border-radius:18px;padding:20px}
    .stat span{display:block;opacity:.8;font-size:.9rem}
    .stat strong{display:block;font-size:2rem;margin-top:7px}
    .admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .table-wrap{overflow:auto}
    table{width:100%;border-collapse:collapse;font-size:.92rem}
    th,td{padding:11px 8px;border-bottom:1px solid #e7edf3;text-align:right;white-space:nowrap}
    th:first-child,td:first-child{text-align:left;white-space:normal;min-width:180px}
    .empty{text-align:center!important;color:var(--muted)}
    .tiny{font-size:.82rem;line-height:1.5}
    @media(max-width:760px){
      .admin-wrap{padding-top:28px}
      .stats-grid{grid-template-columns:1fr 1fr}
      .admin-grid{grid-template-columns:1fr}
      .stat strong{font-size:1.6rem}
    }
  </style>
</BaseLayout>
