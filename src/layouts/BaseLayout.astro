---
import '../styles/global.css';
const {
  title = '생활기술노트',
  description = '생활과 기술을 더 쉽게, 더 정확하게 이해할 수 있도록 실용적인 정보를 전합니다.',
  image = '',
  article = false,
  publishedTime,
  modifiedTime,
  indexable = true
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = '생활기술노트';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
const jsonLd = article ? {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  url:canonical.href,
  mainEntityOfPage:{'@type':'WebPage','@id':canonical.href},
  inLanguage:'ko-KR',
  datePublished:publishedTime,
  dateModified:modifiedTime || publishedTime,
  ...(imageUrl ? { image:[imageUrl] } : {}),
  author:{'@type':'Organization',name:siteName,url:new URL(base, Astro.site).href},
  publisher:{'@type':'Organization',name:siteName,url:new URL(base, Astro.site).href}
} : {
  '@context':'https://schema.org',
  '@type':'WebSite',
  name:siteName,
  url:new URL(base, Astro.site).href,
  description,
  inLanguage:'ko-KR'
};
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-site-verification" content="UwDW2Cs_gSTsHocWy2BkFEteOf2IpzfUThRFz1W4uvY" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="alternate" type="application/rss+xml" title="생활기술노트 RSS" href={`${base}rss.xml`} />
  <meta name="robots" content={indexable ? 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' : 'noindex,follow'} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={siteName} />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  {imageUrl && <meta property="og:image:alt" content={title} />}
  {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {article && (modifiedTime || publishedTime) && <meta property="article:modified_time" content={modifiedTime || publishedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  <meta name="theme-color" content="#153a65" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={base}>
        <span class="brand-mark">생</span>
        <span>생활기술노트</span>
      </a>
      <nav class="nav" aria-label="주요 메뉴">
        <a href={base}>홈</a>
        <a href={`${base}articles/`}>전체 글</a>
        <a href={`${base}about/`}>소개</a>
        <a class="nav-cta" href={`${base}contact/`}>문의</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div><strong>생활기술노트</strong><br/>생활과 기술을 더 쉽게, 더 정확하게 정리합니다.</div>
      <div class="footer-links">
        <a href={`${base}about/`}>소개</a>
        <a href={`${base}privacy/`}>개인정보처리방침</a>
        <a href={`${base}contact/`}>문의</a>
        <a href={`${base}rss.xml`}>RSS</a>
      </div>
      <div>© {new Date().getFullYear()} 생활기술노트</div>
    </div>
  </footer>
</body>
</html>
